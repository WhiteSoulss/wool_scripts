# Diagnostic only. No ad-removal action, ScriptHub, script or remote dependency.
# Keep the existing trusted CA and main-profile settings.
# First disable the Pinterest standalone/bundled rewrite, then enable only this test.
# Reconnect Surge and fully restart Pinterest to avoid reusing the existing connection.

[MITM]
hostname = %APPEND% api.pinterest.com

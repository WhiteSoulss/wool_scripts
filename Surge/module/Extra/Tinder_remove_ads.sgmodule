#!name=Tinder去广告
#!desc=隐藏 Tinder 卡片、Explore、匹配列表广告和 Gold/Platinum 推广；按原版保留奖励视频与付费功能状态。原生 JQ 需要 Surge iOS 5.14+ / Mac 5.9+。
#!author=devchristian1337[https://github.com/devchristian1337/loon-plugins]
#!homepage=https://github.com/WhiteSoulss/wool_scripts/blob/main/Surge/Extra-review/tinder-review-20261011.json
#!raw-url=https://raw.githubusercontent.com/WhiteSoulss/wool_scripts/main/Surge/module/Extra/Tinder_remove_ads.sgmodule
#!icon=https://raw.githubusercontent.com/devchristian1337/loon-plugins/refs/heads/main/App-Icons/tinder.png
#!date=2026-10-11

# Source: https://loon-plugins.vercel.app/plugins/tinder
# Original LPX and JS manually reviewed and archived; native JQ, no runtime JS.
# The original JS selects meta behavior whenever the URL contains /v2/meta.
# The second and third rows preserve that dispatch even inside profile queries.
# Valid unknown JSON shapes pass through; non-JSON/oversize responses are not rewritten.

[Body Rewrite]
http-response-jq ^https:\/\/api\.gotinder\.com\/v2\/meta(\?.*)?$ 'def lever($names;$value): reduce $names[] as $name (.; if (.[$name] | type) == "object" then if (.[$name].value | type) == "boolean" then .[$name].value = $value else . end else . end); def cadence($name): if (.[$name] | type) == "object" then if (.[$name].value | type) == "number" then .[$name].value = 1000000 else . end else . end; if type == "object" then if (.data | type) == "object" then .data |= ((if (.ads | type) == "object" then if (.ads.card_stack | type) == "object" then .ads.card_stack.cadence = 1000000 else . end else . end) | (if (.levers | type) == "object" then .levers |= (lever(["ads.nimbus_recs_ads_enabled","ads.ad_recs_injector_v3_enabled","ads.ads_support_in_modes_enabled","ads.explore_ads_enabled","ads.matchlist_ads_enabled","ads.plus_ads_enabled","ads.promo_enabled","ads.deep_link_ads_enabled","ads.sponsored_message_enabled","ads.sponsored_interest_native_modal_enabled","boost.upsell_modal_enabled","boost.likes_you_merchandising_enabled","boost.get_likes_upsell_enabled","boost.out_of_recs_upsell_enabled","gold_home_v2.new_likes_upsell_enabled","matches.platinum_upsell_enabled","matches.platinum_upsell_v2_enabled","platinum.match_list_upsell_enabled","platinum.my_likes_entrypoint_upsell_enabled","recs_client.likes_you_upsell_modal_enabled","superlike.profile_merchandising_tooltip_enabled","superlike.gamepad_merchandising_tooltip_enabled","superlike.merchandising_tooltip_enabled","superlike.upsell_high_rsrr_enabled","engagement.merchandising_card_app_open_enabled","engagement.merch_card_v2_mirror_enabled","dynamic_content.is_merchandising_card_v2_enabled","controlla_m2.mini_merch_card","rebrand_o2.engagement_merch_card","postmatch.read_receipt_upsell_in_empty_chat_enabled","paywall.primetime_boost_upsell_enabled","paywall.alc_discount_offer_paywall_enabled","bundle_offers_paywall.is_enabled","upsell_boost.relationship_intent_enabled"];false) | lever(["ads.hide_ads","secret_admirer.hide_upsell"];true) | cadence("ads.cadence") | cadence("ads.secondary_cadence")) else . end)) else . end else . end'
http-response-jq ^(?=.*\/v2\/meta)https:\/\/api\.gotinder\.com\/v2\/profile\?include=.*(feature_access|paywalls|purchase) 'def lever($names;$value): reduce $names[] as $name (.; if (.[$name] | type) == "object" then if (.[$name].value | type) == "boolean" then .[$name].value = $value else . end else . end); def cadence($name): if (.[$name] | type) == "object" then if (.[$name].value | type) == "number" then .[$name].value = 1000000 else . end else . end; if type == "object" then if (.data | type) == "object" then .data |= ((if (.ads | type) == "object" then if (.ads.card_stack | type) == "object" then .ads.card_stack.cadence = 1000000 else . end else . end) | (if (.levers | type) == "object" then .levers |= (lever(["ads.nimbus_recs_ads_enabled","ads.ad_recs_injector_v3_enabled","ads.ads_support_in_modes_enabled","ads.explore_ads_enabled","ads.matchlist_ads_enabled","ads.plus_ads_enabled","ads.promo_enabled","ads.deep_link_ads_enabled","ads.sponsored_message_enabled","ads.sponsored_interest_native_modal_enabled","boost.upsell_modal_enabled","boost.likes_you_merchandising_enabled","boost.get_likes_upsell_enabled","boost.out_of_recs_upsell_enabled","gold_home_v2.new_likes_upsell_enabled","matches.platinum_upsell_enabled","matches.platinum_upsell_v2_enabled","platinum.match_list_upsell_enabled","platinum.my_likes_entrypoint_upsell_enabled","recs_client.likes_you_upsell_modal_enabled","superlike.profile_merchandising_tooltip_enabled","superlike.gamepad_merchandising_tooltip_enabled","superlike.merchandising_tooltip_enabled","superlike.upsell_high_rsrr_enabled","engagement.merchandising_card_app_open_enabled","engagement.merch_card_v2_mirror_enabled","dynamic_content.is_merchandising_card_v2_enabled","controlla_m2.mini_merch_card","rebrand_o2.engagement_merch_card","postmatch.read_receipt_upsell_in_empty_chat_enabled","paywall.primetime_boost_upsell_enabled","paywall.alc_discount_offer_paywall_enabled","bundle_offers_paywall.is_enabled","upsell_boost.relationship_intent_enabled"];false) | lever(["ads.hide_ads","secret_admirer.hide_upsell"];true) | cadence("ads.cadence") | cadence("ads.secondary_cadence")) else . end)) else . end else . end'
http-response-jq ^(?!.*\/v2\/meta)https:\/\/api\.gotinder\.com\/v2\/profile\?include=.*(feature_access|paywalls|purchase) 'if type == "object" then if (.data | type) == "object" then .data |= ((if (.feature_access | type) == "object" then if (.feature_access.ad_features | type) == "object" then .feature_access.ad_features.hide_ads = true else . end else . end) | (if (.plus_control | type) == "object" then .plus_control.hide_ads = true else . end) | (if (.entrypoints | type) == "array" then .entrypoints = [] else . end) | (if (.campaigns | type) == "object" then if (.campaigns.campaigns | type) == "array" then .campaigns.campaigns = [] else . end else . end)) else . end else . end'

[MITM]
hostname = %APPEND% api.gotinder.com

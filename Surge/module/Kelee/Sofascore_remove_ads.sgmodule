# Original Loon plugin: https://kelee.one/Tool/Loon/Lpx/Sofascore_remove_ads.lpx
# Configuration: individually authored and reviewed for Surge; no ScriptHub conversion.

# Current Loon SHA256: 248322ccf8db498f6bb9a0651d6ce97d39e2a0def0dbfea797422bddc372267d

# Authored native Surge configuration.

[Map Local]
(?i)^https:\/\/api\.sofascore\.com\/api\/v\d\/dsp\/country\/[A-Z]{2}$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https:\/\/api\.sofascore\.com\/api\/v\d\/trending\/grid\/tiles\/[A-Z]{2}$ data-type=text data="{\"tiles\":[]}" status-code=200 header="Content-Type:application/json"

[MITM]
hostname = %APPEND% api.sofascore.com

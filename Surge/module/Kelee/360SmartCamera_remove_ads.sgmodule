#!name=360摄像机去广告
#!desc=移除开屏广告、首页推广、底栏商城入口及我的页面推广。
#!openUrl=https://apps.apple.com/app/id958068931
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!category=去广告
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/360SmartCamera.png
#!date=2026-10-02 13:57:49

# Original Loon plugin: https://kelee.one/Tool/Loon/Lpx/360SmartCamera_remove_ads.lpx
# Configuration: individually authored and reviewed for Surge; no ScriptHub conversion.

# Current Loon SHA256: a02a7acfd9b6db38b77943a13b30e1ed3a68587b04aec901b8de475bbca497ea

# Authored native Surge configuration.

[Rule]
DOMAIN,ad.jia.360.cn,REJECT
DOMAIN,ad.iot.360.cn,REJECT

[Body Rewrite]
http-response-jq (?i)^https:\/\/jia\.360\.cn\/conf\/v1\.json 'del(.["tab_conf"],.["ad_conf"],.["activity"])'

[MITM]
hostname = %APPEND% jia.360.cn

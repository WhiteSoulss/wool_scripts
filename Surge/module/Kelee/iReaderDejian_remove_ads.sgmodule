#!name=得间小说去广告
#!desc=移除开屏广告、章末广告，移除扉页广告提示、听书界面广告提示、搜索栏填充词。
#!openUrl=https://apps.apple.com/app/id1454487240
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!category=去广告
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/iReaderDejian.png
#!date=2026-10-02 13:57:49

# Original Loon plugin: https://kelee.one/Tool/Loon/Lpx/iReaderDejian_remove_ads.lpx
# Configuration: individually authored and reviewed for Surge; no ScriptHub conversion.

# Current Loon SHA256: d8963f19af6e3fd3eeea80b93ac93db658e614639d74f0e11db81e61d74f6630

# Authored native Surge configuration.

[Rule]
DOMAIN,smad.ms.zhangyue.net,REJECT
DOMAIN,saad.ms.zhangyue.net,REJECT

[Body Rewrite]
http-response-jq (?i)^https:\/\/dj\.palmestore\.com\/zybk\/api\/powerup\/userGroup\? 'del(.["body"]["sevenDaysAd"],.["body"]["shortPlayShow"],.["body"]["sdkShortPlayAB"])'
http-response-jq (?i)^https:\/\/dj\.palmestore\.com\/zybk\/api\/search\/index\? 'del(.["body"]["keywords"])'

[Map Local]
(?i)^https:\/\/dj\.palmestore\.com\/djad\/ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https:\/\/dj\.palmestore\.com\/zybk\/api\/ad\/ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https:\/\/dj\.palmestore\.com\/zyapi\/bookstore\/ad\/ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https:\/\/dj\.palmestore\.com\/zybk\/api\/bookshelf\/index\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[MITM]
hostname = %APPEND% dj.palmestore.com

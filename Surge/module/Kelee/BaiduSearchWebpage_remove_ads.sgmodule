# Original Loon plugin: https://kelee.one/Tool/Loon/Lpx/BaiduSearchWebpage_remove_ads.lpx
# Configuration: individually authored and reviewed for Surge; no ScriptHub conversion.

# Current Loon SHA256: de15529e97e5c6804983f353b9441ff69b5ff42a23cfb4a9ae16aba183ad4aea

# Authored native Surge configuration.

[Script]
BaiduSearchWebpage_remove_ads_1 = type=http-response, pattern="(?i)^https?:\\/\\/(www|m)\\.baidu\\.com\\/?($|\\?from=\\w{8,9})", script-path=https://raw.githubusercontent.com/WhiteSoulss/wool_scripts/main/Surge/Script/Kelee/BaiduSearch/BaiduSearchHomePage_remove_ads.js, requires-body=true, max-size=1048576

[MITM]
hostname = %APPEND% m.baidu.com, www.baidu.com

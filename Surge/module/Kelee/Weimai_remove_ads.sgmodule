# Original Loon plugin: https://kelee.one/Tool/Loon/Lpx/Weimai_remove_ads.lpx
# Configuration: individually authored and reviewed for Surge; no ScriptHub conversion.

# Current Loon SHA256: 9884eff95f618871e69e9609bcaa1d17cd8db0aec06a8e7e5356dd6bc93b4f72

# Authored native Surge configuration.

[Body Rewrite]
http-response-jq (?i)^https:\/\/confssl\d?\.iweimai\.cn\/wm_ios_update\.json\? '.["isShowCJAd"] = 0'
http-response-jq (?i)^https:\/\/confssl\d?\.iweimai\.cn\/wm_ios_update\.json\? 'del(.["launchAd"],.["adBanners"],.["ad"])'

[MITM]
hostname = %APPEND% confssl*.iweimai.cn

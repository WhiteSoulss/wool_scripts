#!name=触站去广告
#!desc=移除开屏广告、弹窗广告、各页面横幅推广，移除首页悬浮挂件。
#!openUrl=https://apps.apple.com/app/id1503129125
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!category=去广告
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Chuzhan.png
#!date=2026-10-02 13:57:49

# Original Loon plugin: https://kelee.one/Tool/Loon/Lpx/Chuzhan_remove_ads.lpx
# Configuration: individually authored and reviewed for Surge; no ScriptHub conversion.

# Current Loon SHA256: 010e40276fe4ef8a23cecf315b1c92fc0d156dce4f494eeeb157e4658579fa3e

# Authored native Surge configuration.

[Map Local]
(?i)^https:\/\/app\.huashi6\.com\/app\/index\/ad\/ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https:\/\/app\.huashi6\.com\/app\/works\/relative$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https:\/\/app\.huashi6\.com\/app\/index\/follow\/all_random\/list$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https:\/\/app\.huashi6\.com\/app\/index\/csyxh\/icon$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Body Rewrite]
http-response-jq (?i)^https:\/\/app\.huashi6\.com\/app\/common\/config$ '.["data"]["disableAd"] = true | .["data"]["showTopFloatAdvanceTips"] = false'
http-response-jq (?i)^https:\/\/app\.huashi6\.com\/app\/common\/config$ 'del(.["data"]["adsConfigIOS"],.["data"]["adsConfigAndroid"],.["data"]["url"]["tabMarket"])'
http-response-jq (?i)^https:\/\/app\.huashi6\.com\/app\/common\/layouts$ '.data |= {CZ_MINE_MENUS: .CZ_MINE_MENUS}'
http-response-jq (?i)^https:\/\/app\.huashi6\.com\/app\/common\/themeConfig$ '.data.tabbars |= map(select(.title != "商城"))'

[MITM]
hostname = %APPEND% app.huashi6.com

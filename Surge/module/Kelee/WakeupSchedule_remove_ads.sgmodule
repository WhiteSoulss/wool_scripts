# Original Loon plugin: https://kelee.one/Tool/Loon/Lpx/WakeupSchedule_remove_ads.lpx
# Configuration: individually authored and reviewed for Surge; no ScriptHub conversion.

# Current Loon SHA256: 2e1038260331e833b9a98bc803eb2184a4ebc7f18496a62c63ecfa65e8c94356

# Authored native Surge configuration.

[Map Local]
(?i)^https:\/\/api\.wakeup\.fun\/wakeup\/app\/bannerconf$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Body Rewrite]
http-response-jq (?i)^https:\/\/api\.wakeup\.fun\/wakeup\/user\/mine$ 'del(.["data"]["bannerItems"])'

[MITM]
hostname = %APPEND% api.wakeup.fun

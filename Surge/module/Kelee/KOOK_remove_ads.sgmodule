#!name=KOOK去广告
#!desc=移除开屏广告、房间横幅推广、促销活动、精简发现页面频道及我的页面，移除底栏商城入口。
#!openUrl=https://apps.apple.com/app/id1501289327
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!category=去广告
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/KOOK.png
#!date=2026-10-02 13:57:49

# Original Loon plugin: https://kelee.one/Tool/Loon/Lpx/KOOK_remove_ads.lpx
# Configuration: individually authored and reviewed for Surge; no ScriptHub conversion.

# Current Loon SHA256: 470341eb77a8f73fc53172576e22fcf814fd10a6b0d1a3ad35738828f444cc1d

# Authored native Surge configuration.

[Map Local]
(?i)^https:\/\/www\.kookapp\.cn\/api\/v3\/ad\/config$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https:\/\/www\.kookapp\.cn\/api\/v3\/promotion\/ongoing$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Body Rewrite]
http-response-jq (?i)^https:\/\/(m|www)\.kookapp\.cn\/api\/v\d\/user\/settings$ 'del(.["ad_banner"],.["advertise_on_off"])'
http-response-jq (?i)^https:\/\/(m|www)\.kookapp\.cn\/api\/v\d\/user\/settings$ '.["ios_mall_switch"] = false'
http-response-jq (?i)^https:\/\/www\.kookapp\.cn\/api\/v3\/discover\/tab-list\? '.data.items |= map(select(.id == 472 or .id == 473 or .id == 475))'

[MITM]
hostname = %APPEND% m.kookapp.cn, www.kookapp.cn

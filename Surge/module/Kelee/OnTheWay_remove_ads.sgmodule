#!name=行者户外去广告
#!desc=移除弹窗广告、发现页面横幅推广的推广金刚位，移除我的页面横幅推广。
#!openUrl=https://apps.apple.com/app/id779325629
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!category=去广告
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/OnTheWay.png
#!date=2026-10-02 13:57:49

# Original Loon plugin: https://kelee.one/Tool/Loon/Lpx/OnTheWay_remove_ads.lpx
# Configuration: individually authored and reviewed for Surge; no ScriptHub conversion.

# Current Loon SHA256: 1a0888cf708921ac4cacbc2dd90538506726ed2bebd6913c7cf85348f67c599e

# Authored native Surge configuration.

[Map Local]
(?i)^https:\/\/www\.imxingzhe\.com\/api\/v1\/pop\/window\/\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Body Rewrite]
http-response-jq (?i)^https:\/\/www\.imxingzhe\.com\/api\/v4\/account\/get_user_info\? 'del(.["banner"])'
http-response-jq (?i)^https:\/\/www\.imxingzhe\.com\/api\/v4\/discovery\/ios\/\? 'del(.["banners"],.["ad"])'
http-response-jq (?i)^https:\/\/www\.imxingzhe\.com\/api\/v4\/discovery\/ios\/\? '.display_areas |= map(select(.name == "赛事" or .name == "行者帮" or .name == "头条" or .name == "排行榜" or .name == "约伴"))'

[MITM]
hostname = %APPEND% www.imxingzhe.com

# Original Loon plugin: https://kelee.one/Tool/Loon/Lpx/RiskBird_remove_ads.lpx
# Configuration: individually authored and reviewed for Surge; no ScriptHub conversion.

# Current Loon SHA256: ed4944c91b2d5168fffeeb9c38428ce455fb7491fa5736076f9621f660981fa3

# Authored native Surge configuration.

[Map Local]
(?i)^https:\/\/m\.riskbird\.com\/prod-qbb-api\/user\/getBannerList data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https:\/\/m\.riskbird\.com\/prod-qbb-api\/searchHotEnt data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Script]
RiskBird_remove_ads_1 = type=http-response, pattern=(?i)^https:\/\/m\.riskbird\.com\/prod-qbb-api\/query\/person\/personRecommend, script-path=https://raw.githubusercontent.com/WhiteSoulss/wool_scripts/main/Surge/Script/Kelee/RiskBird/RiskBird_remove_ads.js, requires-body=true, max-size=1048576

[MITM]
hostname = %APPEND% m.riskbird.com

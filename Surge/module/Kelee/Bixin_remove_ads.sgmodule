# Original Loon plugin: https://kelee.one/Tool/Loon/Lpx/Bixin_remove_ads.lpx
# Configuration: individually authored and reviewed for Surge; no ScriptHub conversion.

# Current Loon SHA256: 3fc203cb01bab2b5e960ef2ddee636cd9c53fae416002a5fa4b0427726114437

# Authored native Surge configuration.

[Map Local]
(?i)^https:\/\/web\.hibixin\.com\/user-recall\/signModal$ data-type=text data="" status-code=404 header="Content-Type:text/plain"
(?i)^https:\/\/api\.hibixin\.com\/config\/v\d\/common\/popup$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https:\/\/gateway\.hibixin\.com\/resource\/v\d\/rec\/card\/query$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https:\/\/api\.hibixin\.com\/msg\/user\/friends\/trends\/top$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https:\/\/gateway\.xxqapp\.cn\/live\/pendant\/index\/items$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https:\/\/api\.xxqapp\.cn\/banner\/list\/\d$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https:\/\/api\.hibixin\.com\/content\/v\d\/home\/page\/list$ data-type=text data="{\"code\":\"8000\",\"msg\":\"SUCCESS\",\"success\":true}" status-code=200 header="Content-Type:application/json"
(?i)^https:\/\/api\.hibixin\.com\/resource\/v\d\/discovery\/entrance\/activity$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https:\/\/gateway\.hibixin\.com\/config\/search\/qryConfigPart$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https:\/\/gateway\.xxqapp\.cn\/live\/flow\/pendant\/meta$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https:\/\/web-bxyuer\.bixin\.cn\/yuer-ads\? data-type=text data="" status-code=404 header="Content-Type:text/plain"
(?i)^https:\/\/gateway\.bxyuer\.com\/official\/room\/tab\/pop$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https:\/\/gateway\.xxqapp\.cn\/living\/room\/fetch\/recommend-follow-list$ data-type=text data="{\"code\":\"8000\",\"msg\":\"SUCCESS\",\"success\":true}" status-code=200 header="Content-Type:application/json"
(?i)^https:\/\/api\.hibixin\.com\/biggie\/query\/skill\/detail\/relateRecommendBiggieV\d$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Body Rewrite]
http-response-jq (?i)^https:\/\/api\.hibixin\.com\/biggie\/home\/v\d\/query\/biggie$ '.result.list |= map(select(has("bannerList") and .bannerList == null))'
http-response-jq (?i)^https:\/\/api\.hibixin\.com\/resource\/v\d\/common\/tab$ '.result |= map(select(.type != "activityCenter"))'

[Script]
Bixin_remove_ads_1 = type=http-response, pattern=(?i)^https:\/\/gateway\.hibixin\.com\/resource\/v\d\/common\/tab\/query$, script-path=https://raw.githubusercontent.com/WhiteSoulss/wool_scripts/main/Surge/Script/Kelee/Bixin/common_tab.js, requires-body=true, max-size=1048576, engine=webview
Bixin_remove_ads_2 = type=http-response, pattern=(?i)^https:\/\/gateway\.hibixin\.com\/resource\/v\d\/my\/page$, script-path=https://raw.githubusercontent.com/WhiteSoulss/wool_scripts/main/Surge/Script/Kelee/Bixin/my_page.js, requires-body=true, max-size=1048576, engine=webview

[MITM]
hostname = %APPEND% web.hibixin.com, api.hibixin.com, gateway.hibixin.com, gateway.xxqapp.cn, api.xxqapp.cn, web-bxyuer.bixin.cn, gateway.bxyuer.com

# Original Loon plugin: https://kelee.one/Tool/Loon/Lpx/SafetyHome_remove_ads.lpx
# Configuration: individually authored and reviewed for Surge; no ScriptHub conversion.

# Current Loon SHA256: 13d8ae0450c9b3289f454933a44f256ca05e77a87552d71e8506820171a77e89

# Authored native Surge configuration.

[Rule]
DOMAIN,ad.iot.360.cn,REJECT

[Map Local]
(?i)^https:\/\/app\.home\.360\.cn\/v1\/config\/custom_config data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[MITM]
hostname = %APPEND% app.home.360.cn

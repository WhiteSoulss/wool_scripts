# Authored native Surge configuration.

[Map Local]
(?i)^https:\/\/api\.tdz5\.com\/search\/hotword\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https:\/\/api\.tdz5\.com\/ring\/hot\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Script]
ShoujiDesk_remove_ads_1 = type=http-response, pattern=(?i)^https:\/\/api\.tdz5\.com\/base\/init\?, script-path=https://raw.githubusercontent.com/WhiteSoulss/wool_scripts/main/Surge/Script/Kelee/ShoujiDesk/base_init.js, requires-body=true, max-size=1048576, engine=webview

[MITM]
hostname = %APPEND% api.tdz5.com

# Original Loon plugin: https://kelee.one/Tool/Loon/Lpx/TCLnScreen_remove_ads.lpx
# Configuration: individually authored and reviewed for Surge; no ScriptHub conversion.

# Current Loon SHA256: 691c8405aa8c03e602c48975f294320dbf094580b04f443f2845d7d8cfbd1b58

# Authored native Surge configuration.

[Map Local]
(?i)^https:\/\/tcast-o\.api\.leiniao\.com\/tcast\/ads\/ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https:\/\/tcast-o\.api\.leiniao\.com\/tcast\/v\d\/selection\/banner$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https:\/\/tcast-o\.api\.leiniao\.com\/tcast\/v\d\/searchrank$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https:\/\/tcast-o\.api\.leiniao\.com\/tcast\/v\d\/selection\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https:\/\/tcast-o\.api\.leiniao\.com\/tcast\/message\/v\d\/activity\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Body Rewrite]
http-response-jq (?i)^https:\/\/tcast-o\.api\.leiniao\.com\/tcast\/v\d\/config\/function\? '.data |= map(select(.module == "tools"))'

[MITM]
hostname = %APPEND% tcast-o.api.leiniao.com

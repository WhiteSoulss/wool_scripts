#!name=阅友去广告
#!desc=移除开屏广告、弹窗广告和阅读页面广告，移除底栏福利按钮。
#!openUrl=https://apps.apple.com/app/id1066723192
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!category=去广告
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Yueyou.png
#!date=2026-10-02 13:57:49

# Original Loon plugin: https://kelee.one/Tool/Loon/Lpx/Yueyou_remove_ads.lpx
# Configuration: individually authored and reviewed for Surge; no ScriptHub conversion.

# Current Loon SHA256: e4f19502e844825ecf4307fa141b29f7e475f15e1e63bd4674cb5a2680f90e7c

# Authored native Surge configuration.

[Rule]
DOMAIN,ads.reader.yueyouxs.com,REJECT

[Body Rewrite]
http-response-jq (?i)^https:\/\/goway\.reader\.yueyouxs\.com\/assemble\/app\/basic\/getAppInfo\? 'del(.["data"]["isShowDLPopup"],.["data"]["isShowGame"],.["data"]["touTiaoShowDlPopup"],.["data"]["offLineDownload"]["WatchVideoBtnDesc"],.["data"]["readVipFirstCfg"],.["data"]["readVipNormalCfg"],.["data"]["notifyAd"],.["data"]["hotStartSplashTime"],.["data"]["hotStartReqSwitch"],.["data"]["isShowBFTab"],.["data"]["popReqDelayTime"],.["data"]["benefitCfg"],.["data"]["chestTask"],.["data"]["hotStartAd"],.["data"]["activeTagList"],.["data"]["secondOrderCfg"],.["data"]["secondOrderList"],.["data"]["blockedWordsCfg"],.["data"]["aaReportListCfg"],.["data"]["pddAdSwitch"],.["data"]["isShowShelfAuthPopup"],.["data"]["firstPopUpAmount"])'
http-response-jq (?i)^https:\/\/goway\.reader\.yueyouxs\.com\/assemble\/app\/basic\/getAppInfo\? '.["data"]["isAdClosed"] = true'

[MITM]
hostname = %APPEND% goway.reader.yueyouxs.com

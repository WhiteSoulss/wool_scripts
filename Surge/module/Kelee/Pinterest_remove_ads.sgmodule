# Original Loon plugin: https://kelee.one/Tool/Loon/Lpx/Pinterest_remove_ads.lpx
# Configuration: manually rewritten native Surge response adapter, 2026-10-11; no ScriptHub.

# Current Loon SHA256: 905ce81e2a26cb5421219b8f9009502d7c014291b3b3a5532e13dd6ad3a01d95

# Original LPX date: 2026-10-02 13:57:49
# Remove only is_promoted=true/"true"; preserve unknown markers and unexpected response shapes.
# Limit the script to the original two endpoints and 1 MiB bodies; other responses pass through.

[Script]
Pinterest_remove_ads = type=http-response, pattern=(?i)^https:\/\/api\.pinterest\.com\/v\d\/(?:feeds\/home|pins\/\d+\/related\/modules)\/\?, script-path=https://raw.githubusercontent.com/WhiteSoulss/wool_scripts/main/Surge/Script/Kelee/Pinterest/remove-ads.js, requires-body=true, max-size=1048576, timeout=5

[MITM]
hostname = %APPEND% api.pinterest.com
